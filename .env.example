# Copy this file to .env and fill in your values. .env is git-ignored; never
# commit real credentials. Docker Compose reads .env automatically for the
# variable substitutions in docker-compose.yml.

# Mudah automation permission gate. Keep 0 until Mudah has authorised your use.
# The service exits without making any Mudah request while this is not 1.
MUDAH_AUTOMATION_ALLOWED=0

# Telegram bot credentials. Leave blank to run without sending; the service
# will refuse to start and log a clear message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
