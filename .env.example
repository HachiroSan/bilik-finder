# Copy this file to .env and fill in your values. .env is git-ignored; never
# commit real credentials. Docker Compose reads .env automatically for the
# variable substitutions in docker-compose.yml, and the local `py run_alerts.py`
# launcher loads this same root .env (stdlib only, values never printed). A
# variable already set in the real environment always wins over this file.

# Mudah automation permission gate. Keep 0 until Mudah has authorised your use.
# While this is not 1 the alert service logs a warning and skips the Mudah
# searches, and any configured iBilik searches keep polling (iBilik is a public
# API and ignores this flag). The standalone Mudah finder still requires 1.
MUDAH_AUTOMATION_ALLOWED=0

# Telegram bot credentials. Both are required for the service to send; leave
# them blank for --dry-run, which only reports matches. Values are never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
